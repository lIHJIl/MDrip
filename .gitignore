build/
dist/

# Scratch & temporary files
scratch_*.py
*.tmp
*.log

# Generated test output files
test_files/*.md

# Operating System files
Thumbs.db
Desktop.ini
.DS_Store

# IDE and Editor configurations
.idea/
.vscode/
*.swp
*.swo
